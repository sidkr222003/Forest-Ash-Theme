    "configuration": {
      "title": "Forest Ash Theme",
      "properties": {
        "forestAsh.defaultVariant": {
          "type": "string",
          "enum": [
            "dark",
            "light"
          ],
          "default": "dark",
          "description": "Default variant when generating a custom theme.",
          "enumDescriptions": [
            "Deep, low-glare dark background",
            "Paper-like light background"
          ]
        },
        "forestAsh.lastBaseColor": {
          "type": "string",
          "default": "#4a9eff",
          "description": "Last used base accent color for theme generation (hex).",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "forestAsh.showSwatchInStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show active custom theme color swatch in the status bar."
        },
        "forestAsh.focusMode.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable Focus Mode dimming and Zen palette overrides."
        },
        "forestAsh.focusMode.dimOpacity": {
          "type": "number",
          "default": 0.35,
          "minimum": 0.05,
          "maximum": 0.9,
          "description": "Opacity for dimmed code outside the active block in Focus Mode."
        },
        "forestAsh.italicMode.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Toggle italic font styles for Forest Ash token colors."
        },
        "forestAsh.highContrast.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Boost contrast ratios for Forest Ash themes."
        },
        "forestAsh.languageAccents": {
          "type": "object",
          "default": {},
          "description": "Map language IDs to accent colors (hex) for per-language overrides."
        },
        "forestAsh.circadian.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Automatically switch between day and night Forest Ash themes."
        },
        "forestAsh.circadian.dayTheme": {
          "type": "string",
          "default": "Forest Ash Yoru Paper Light",
          "description": "Theme to use during the day in Circadian mode."
        },
        "forestAsh.circadian.nightTheme": {
          "type": "string",
          "default": "Forest Ash",
          "description": "Theme to use at night in Circadian mode."
        },
        "forestAsh.circadian.dayStart": {
          "type": "string",
          "default": "07:00",
          "description": "Day mode start time in 24h format (HH:mm)."
        },
        "forestAsh.circadian.nightStart": {
          "type": "string",
          "default": "19:00",
          "description": "Night mode start time in 24h format (HH:mm)."
        },
        "forestAsh.circadian.timezone": {
          "type": "string",
          "default": "",
          "description": "Time zone ID for Circadian mode. Leave blank to use system time zone."
        },
        "forestAsh.circadian.checkIntervalMinutes": {
          "type": "number",
          "default": 5,
          "minimum": 1,
          "description": "How often (in minutes) to re-evaluate Circadian theme switching."
        },
        "forestAsh.themeOfWeek.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show the Theme of the Week webview on startup (once per week)."
        },
        "forestAsh.multiToolExport.lastTool": {
          "type": "string",
          "default": "",
          "description": "ID of the last tool used in the Export for External Tool command (for pre-selection)."
        }
      }
    },
